# ==============================================================================
# CloudMask AI - Backend Environment Configuration (.env.example)
# Copy this file to .env in backend/ or root to override default settings.
# ==============================================================================

# --- Model & Storage ---
# Path to the trained U-Net checkpoint (.pt)
# Default searches local directory and parent directory for cloudmask_unet_best.pt
MODEL_PATH=cloudmask_unet_best.pt

# --- Server Host & Port ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# --- Security & CORS ---
# Comma-separated allowed origin URLs (no wildcard credentials)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Set to true ONLY when deployed behind a trusted reverse proxy (NGINX, Cloud Run, Cloudflare)
# When true, the leftmost IP in X-Forwarded-For is used for rate limiting.
TRUST_PROXY=false

# --- Concurrency & Memory Protection ---
# Maximum concurrent CPU/GPU inference tasks executed off the event loop
# Requests beyond this limit queue cleanly via asyncio.Semaphore without exhausting VRAM/RAM
MAX_CONCURRENT_INFERENCE=2

# --- Sliding-Window Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=15
RATE_LIMIT_WINDOW_SECONDS=60

# --- Model Downloader (download_model.py) ---
# Optional: GitHub token for authenticated releases API requests (avoids CI rate limits)
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
